ENV = 'development'

# 默认BASE URL
VUE_APP_BASE_API = 'http://182.40.194.71:30800'

# TODO: 目前后端连接位于 8960端口 k8s 服务，需要后端调整后再同步调整
# WebSocket 连接地址
VUE_APP_WS_API = 'ws://182.40.194.71:30960/ws'

# 数据管理
VUE_APP_DATA_API = 'http://182.40.194.71:30800'

# 训练可视化
VUE_APP_VISUAL_API = ''

# 用户 minio 访问地址
VUE_APP_MINIO_API = 'http://182.40.194.71:30800'

# atlas 服务，需要单独部署
VUE_APP_ATLAS_HOST = ''

# 医疗影像 DCM4CHEE 服务访问地址
# 部署文档参考：http://huitongdao.doc.huizhidata.com/docs/setup/deploy-algorithm
VUE_APP_DCM_API = 'http://{HOST}/dcm4chee/dcm4chee-arc/aets/DCM4CHEE_ADMIN'

# minIO 服务 IP
# 部署文档参考：http://htd.huizhidata.com/docs/setup/deploy-minio
VUE_APP_MINIO_ENDPOINT = '182.40.194.71'

# minIO 服务 端口
VUE_APP_MINIO_PORT = '30900'

# 是否开启 SSL
VUE_APP_MINIO_USESSL = 'false'

# bucketName
VUE_APP_MINIO_BUCKETNAME = 'htd-prod'

# 文档链接
VUE_APP_DOCS_URL = http://huitongdao.doc.huizhidata.com/docs/